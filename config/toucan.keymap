#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define ETC 1
#define NAV 2
#define MED 3
#define SYM 4
#define NUM 5
#define FUN 6
#define MOU 7
#define GAL 8

// Shared home row mod timing - tweak these two and it applies everywhere below

#define HRM_TAPPING_TERM_MS 200
#define HRM_REQUIRE_PRIOR_IDLE_MS 150
#define AUTOSHIFT_TAPPING_TERM_MS 175

// Key position groups (urob-style) - used as hold-trigger-key-positions below.
// Thumbs are shared across both hands: a thumb press alongside a home row mod
// is almost always a deliberate chord, not a same-hand roll, so it's included
// as a valid hold trigger for either side rather than split left/right.

#define KEYS_L 1 2 3 4 5 13 14 15 16 17 25 26 27 28 29
#define KEYS_R 6 7 8 9 10 18 19 20 21 22 30 31 32 33 34
#define THUMBS 36 37 38 39 40 41

/ {
    conditional_layers { compatible = "zmk,conditional-layers"; };

    behaviors {
        // Home row mods: GUI / ALT / CTRL - Flow Tap enabled via require-prior-idle-ms

        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <HRM_TAPPING_TERM_MS>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <HRM_REQUIRE_PRIOR_IDLE_MS>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_RIGHT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <HRM_TAPPING_TERM_MS>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <HRM_REQUIRE_PRIOR_IDLE_MS>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };

        // Home row mods: SHIFT only. tapping-term-ms is shared via the define
        // above; require-prior-idle-ms stays hardcoded at 0 (not the shared
        // variable) - same-hand-vs-cross-hand is enforced by hold-trigger-key-positions
        // below (opposite hand only) + hold-trigger-on-release.

        hms_l: homerow_mods_shift_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_SHIFT_LEFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <HRM_TAPPING_TERM_MS>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <0>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        hms_r: homerow_mods_shift_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_SHIFT_RIGHT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <HRM_TAPPING_TERM_MS>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <0>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };

        // Punctuation mod-morphs: tap for the base symbol, shift for the
        // alternate. Replaces the default shifted output of each key
        // (e.g. shift+. is normally >, this makes it : instead).

        dot_colon: dot_colon {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_COLON";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp COLON>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        comma_semi: comma_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_SEMI";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SEMI>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        qmark_bang: qmark_bang {
            compatible = "zmk,behavior-mod-morph";
            label = "QMARK_BANG";
            #binding-cells = <0>;
            bindings = <&kp QMARK>, <&kp EXCL>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        auto_shift: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <AUTOSHIFT_TAPPING_TERM_MS>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";
        timeout-ms = <25>;

        Screenshot {
            bindings = <&kp LS(LG(S))>;
            key-positions = <1 2>;
            require-prior-idle-ms = <500>;
            layers = <0>;
        };

        Refresh {
            bindings = <&kp F5>;
            key-positions = <4 3>;
            require-prior-idle-ms = <500>;
            layers = <0>;
        };

        Save-Send {
            bindings = <&kp LA(S)>;
            key-positions = <13 25>;
            layers = <0>;
            require-prior-idle-ms = <500>;
        };

        Copy {
            bindings = <&kp LC(C)>;
            key-positions = <26 27>;
            require-prior-idle-ms = <500>;
            layers = <0>;
        };

        Paste {
            bindings = <&kp LC(V)>;
            key-positions = <27 28>;
            layers = <0>;
            require-prior-idle-ms = <500>;
        };

        Cut {
            bindings = <&kp LC(X)>;
            key-positions = <28 26>;
            require-prior-idle-ms = <500>;
            layers = <0>;
        };

        Caps-Word {
            bindings = <&caps_word>;
            key-positions = <20 19>;
            layers = <0>;
        };

        Space {
            bindings = <&kp SPACE>;
            key-positions = <16 15>;
            layers = <0>;
            require-prior-idle-ms = <500>;
        };

        Enter {
            bindings = <&kp ENTER>;
            key-positions = <28 29>;
            layers = <0 7>;
            require-prior-idle-ms = <350>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main {
            display-name = "MAIN";
            bindings = <
&none  &kp Q        &kp W        &kp E           &kp R              &kp T        &kp Y          &kp U          &kp I           &kp O        &kp P          &none
&none  &hml LGUI A  &hml LALT S  &hms_l LSHFT D  &hml LCTRL F       &kp G        &kp H          &hmr RCTRL J   &hms_r RSHFT K  &hmr RALT L  &hmr RGUI SQT  &none
&none  &kp Z        &kp X        &kp C           &kp V              &kp B        &kp N          &kp M          &comma_semi     &dot_colon   &qmark_bang    &none
                                 &lt ETC DELETE  &lt NAV BACKSPACE  &lt MED TAB  &lt SYM ENTER  &lt NUM SPACE  &lt FUN ESCAPE
            >;
        };

        etc {
            display-name = "ETC";
            bindings = <
&none  &none        &none         &none           &none      &none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none
&none  &kp LGUI     &kp LEFT_ALT  &kp LEFT_SHIFT  &kp LCTRL  &none  &none         &none         &none         &none         &none         &none
&none  &bootloader  &none         &none           &none      &none  &bt BT_CLR    &none         &none         &none         &bootloader   &none
                                  &none           &none      &none  &none         &none         &none
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
&none  &msc SCRL_UP  &msc SCRL_DOWN  &none           &none      &none  &kp PAGE_UP    &kp HOME       &kp UP_ARROW      &kp END           &none         &none
&none  &kp LGUI      &kp LEFT_ALT    &kp LEFT_SHIFT  &kp LCTRL  &none  &kp PAGE_DOWN  &kp LEFT       &kp DOWN_ARROW    &kp RIGHT         &kp K_MENU    &none
&none  &none         &none           &none           &none      &none  &kp INSERT     &kp C_AC_BACK  &kp C_AC_REFRESH  &kp C_AC_FORWARD  &kp CAPSLOCK  &none
                                     &none           &none      &none  &kp LC(Y)      &kp LC(Z)      &none
            >;
        };

        med {
            display-name = "MED";
            bindings = <
&none  &none     &none         &none           &none      &none  &none  &none             &none            &none              &none       &none
&none  &kp LGUI  &kp LEFT_ALT  &kp LEFT_SHIFT  &kp LCTRL  &none  &none  &kp C_PLAY_PAUSE  &kp C_VOLUME_UP  &kp C_VOLUME_DOWN  &kp C_MUTE  &none
&none  &none     &none         &none           &none      &none  &none  &kp C_NEXT        &kp C_PREV       &none              &none       &none
                               &none           &none      &none  &none  &none             &none
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
&none  &kp AMPERSAND  &kp DOLLAR   &kp LESS_THAN     &kp GREATER_THAN      &kp TILDE              &none  &none      &none            &none          &none     &none
&none  &kp CARET      &kp HASH     &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp BACKSLASH          &none  &kp RCTRL  &kp RIGHT_SHIFT  &kp RIGHT_ALT  &kp RGUI  &none
&none  &kp PERCENT    &kp AT_SIGN  &kp LEFT_BRACE    &kp RIGHT_BRACE       &kp PIPE               &none  &none      &none            &none          &none     &none
                                   &kp GRAVE         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none  &none      &none
            >;
        };

        num {
            display-name = "NUM";
            bindings = <
&none  &kp PLUS    &kp N7  &kp N8  &kp N9  &kp ASTERISK  &none  &none      &none            &none          &none     &none
&none  &kp MINUS   &kp N4  &kp N5  &kp N6  &kp SLASH     &none  &kp RCTRL  &kp RIGHT_SHIFT  &kp RIGHT_ALT  &kp RGUI  &none
&none  &kp PERIOD  &kp N1  &kp N2  &kp N3  &kp EQUAL     &none  &none      &none            &none          &none     &none
                           &none   &kp N0  &kp UNDER     &none  &none      &none
            >;
        };

        fun {
            display-name = "FUN";
            bindings = <
&none  &kp F12  &kp F7  &kp F8  &kp F9  &kp PRINTSCREEN  &none  &none      &none            &none          &none     &none
&none  &kp F10  &kp F4  &kp F5  &kp F6  &kp SCROLLLOCK   &none  &kp RCTRL  &kp RIGHT_SHIFT  &kp RIGHT_ALT  &kp RGUI  &none
&none  &kp F11  &kp F1  &kp F2  &kp F3  &kp PAUSE_BREAK  &none  &none      &none            &none          &none     &none
                        &none   &none   &none            &none  &none      &none
            >;
        };

        mou {
            display-name = "MOU";
            bindings = <
&none  &trans  &trans  &trans     &trans     &trans     &trans     &trans     &trans     &trans  &trans  &none
&none  &trans  &trans  &trans     &trans     &trans     &trans     &trans     &trans     &trans  &trans  &none
&none  &trans  &trans  &trans     &trans     &trans     &trans     &trans     &trans     &trans  &trans  &none
                       &mkp MCLK  &mkp LCLK  &mkp RCLK  &mkp LCLK  &mkp RCLK  &mkp MCLK
            >;
        };

        gal {
            display-name = "GAL";
            bindings = <
&none  &kp B        &kp L        &kp D           &kp C              &kp V        &kp J          &kp Y          &kp O           &kp U        &comma_semi  &none
&none  &hml LGUI N  &hml LALT R  &hms_l LSHFT T  &hml LCTRL S       &kp G        &kp P          &hmr RCTRL H   &hms_r RSHFT A  &hmr RALT E  &hmr RGUI I  &none
&none  &kp X        &kp Q        &kp M           &kp W              &kp Z        &kp K          &kp F          &kp SQT         &qmark_bang  &dot_colon   &none
                                 &lt ETC DELETE  &lt NAV BACKSPACE  &lt MED TAB  &lt SYM ENTER  &lt NUM SPACE  &lt FUN ESCAPE
            >;
        };
    };
};
